# ───────────────────────────────────────────────────────────────
#  口令 / 配置文件
#  用法：把本文件复制一份、改名为  .env  ，再按下面说明填写。
#  服务器启动时会自动读取 .env（改完重启服务即可生效）。
#  这个文件不会被提交到代码仓库（已在 .gitignore），放心写。
# ───────────────────────────────────────────────────────────────

# 【必填·后台密码】自己想一串只有你知道的字符。
#   作用：保护 /admin 管理页，只有输对它的人才能进去录订单号。
#   进 /admin 时，在口令框里输入的就是这一串。
ADMIN_TOKEN=xiaoba-9527-abc

# 【可留空·防伪密钥】服务器内部用它给“已验证”的登录凭证签名，防止别人伪造。
#   你不会在任何界面输入它。留空会自动生成并保存到 data/.secret。
#   正式上线建议也自己填一串随机字符（更稳，重启/多实例都不失效）。
TOKEN_SECRET=

# 服务端口（一般不用改）
PORT=8787

# 允许的前端来源。前后端同一个服务（推荐）填 * 即可；分开部署时填你的前端域名，如 https://yourtest.com
ALLOW_ORIGIN=*

# 一个订单号 / 解锁码最多可在几台设备上解锁（默认 2，方便买家手机+电脑或清缓存后再用）
MAX_DEVICES_PER_CODE=2

# 登录令牌有效期（天）。在此期间买家无需重复输入订单号。
TOKEN_TTL_DAYS=30

# 是否允许“任意 8 位以上纯数字订单号”直接通过（默认 false，几乎不设防，慎开）
ACCEPT_ANY_LONG_NUMBER=false
