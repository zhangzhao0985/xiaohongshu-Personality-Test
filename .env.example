# 复制本文件为 .env，按需修改（也可直接用环境变量注入）

# 【必填】管理口令：进 /admin 管理页、调用管理接口都要用它。请改成一长串只有你知道的字符。
ADMIN_TOKEN=please-change-this-to-a-long-secret

# 【可选】登录令牌的签名密钥。留空会自动生成并保存到 data/.secret（重启后令牌不失效）。
TOKEN_SECRET=

# 服务端口
PORT=8787

# 允许的前端来源。前后端同一个服务（推荐）填 * 即可；分开部署时填你的前端域名，如 https://yourtest.com
ALLOW_ORIGIN=*

# 一个订单号 / 解锁码最多可在几台设备上解锁（默认 2，方便买家手机+电脑或清缓存后再用）
MAX_DEVICES_PER_CODE=2

# 登录令牌有效期（天）。在此期间买家无需重复输入订单号。
TOKEN_TTL_DAYS=30

# 是否允许“任意 8 位以上纯数字订单号”直接通过（默认 false，几乎不设防，慎开）
ACCEPT_ANY_LONG_NUMBER=false
